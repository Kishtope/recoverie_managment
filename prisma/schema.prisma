datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum Role {
  ADMIN
  MANAGER
  AGENCY_OWNER
  AGENT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Company {
  AF
  BLD
  MF
  MMPL
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String?       @unique
  mobile       String?       @unique
  passwordHash String
  role         Role          @default(AGENT)
  status       UserStatus    @default(ACTIVE)
  agencyId     String?
  agency       Agency?       @relation("AgencyMembers", fields: [agencyId], references: [id])
  reportsToId  String?
  reportsTo    User?         @relation("ReportsTo", fields: [reportsToId], references: [id])
  reports      User[]        @relation("ReportsTo")
  lastLoginAt  DateTime?
  access       UserAccess[]
  ownedAgency  Agency?       @relation("AgencyOwner")
  allocations  Allocation[]  @relation("AgentAllocations")
  dispositions Disposition[] @relation("AgentDispositions")
  questions    CustomerQuestion[] @relation("QuestionCreator")
  calls        Call[]        @relation("AgentCalls")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model UserAccess {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company
  branch  String // see BRANCHES in lib/constants.ts

  @@unique([userId, company, branch])
}

model Agency {
  id            String       @id @default(cuid())
  name          String       @unique
  ownerUserId   String?      @unique
  owner         User?        @relation("AgencyOwner", fields: [ownerUserId], references: [id])
  commissionPct Decimal?     @db.Decimal(5, 2)
  members       User[]       @relation("AgencyMembers")
  allocations   Allocation[]
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String // e.g. "user.create", "user.role_change", "user.disable"
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

enum LoanStatus {
  ACTIVE
  CLOSED
}

enum ImportType {
  LOANS
  ALLOCATIONS
  PAYMENTS
}

enum ImportStatus {
  RUNNING
  DONE
  FAILED
}

model Customer {
  id                 String    @id @default(cuid())
  hubCustomerId      String?   @unique // set when the hub export carries a customer id (open question)
  name               String
  mobilePrimary      String?
  mobileAlt          String?
  doNotCall          Boolean   @default(false) // customer asked not to be called; calls are blocked until an Admin / Manager clears it
  references         Json? // [{ name, relation, mobile }]
  address            String?   @db.Text
  pin                String?
  area               String?
  retailerId         String? // the retailer holding this customer, from the Retailer Code in the uploaded file; null for caller customers
  retailer           Retailer? @relation(fields: [retailerId], references: [id])
  retailerAssignedOn DateTime?
  retailerImportId   String? // the upload (ImportRun) whose Retailer Code gave this customer to the retailer
  loans              Loan[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([retailerId])
}

model Loan {
  id            String       @id @default(cuid())
  agreementNo   String       @unique
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id])
  company       Company
  branch        String // validated against BRANCHES on import
  disbursedOn   DateTime?    @db.Date
  emiAmount     Decimal?     @db.Decimal(12, 2)
  pendingEmis   Int?
  dpd           Int?
  overdueAmount Decimal?     @db.Decimal(12, 2)
  status        LoanStatus   @default(ACTIVE)
  allocations   Allocation[]
  lastImportId  String? // the ImportRun that last changed this loan
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Latest follow-up state, kept in step with Disposition in one transaction so lists need no per-row subquery.
  lastOutcome       Outcome?
  lastContactedAt   DateTime?
  nextFollowUpOn    DateTime?     @db.Date
  notReachableCount Int           @default(0) // consecutive NOT_REACHABLE outcomes
  fieldVisitFlag    Boolean       @default(false) // set after 3 not-reachable; Phase 2B builds the field queue from it
  escalatedAt       DateTime? // set by REFUSED_DISPUTE so a manager can see it
  dispositions      Disposition[]
  calls             Call[]
  payments          Payment[]
  settlements       Settlement[]

  @@index([company, branch])
  @@index([nextFollowUpOn])
}

model Allocation {
  id           String    @id @default(cuid())
  loanId       String
  loan         Loan      @relation(fields: [loanId], references: [id])
  // Equals loanId while active, null otherwise: MySQL has no partial unique index, this gives "one active allocation per loan".
  activeLoanId String?   @unique
  agencyId     String?
  agency       Agency?   @relation(fields: [agencyId], references: [id])
  agentId      String?
  agent        User?     @relation("AgentAllocations", fields: [agentId], references: [id])
  assignedById String?
  assignedOn   DateTime
  validTill    DateTime?
  active       Boolean   @default(true)
  endedAt      DateTime?
  importRunId  String?
  createdAt    DateTime  @default(now())

  @@index([agentId, active])
  @@index([agencyId, active])
  @@index([loanId])
}

model ImportRun {
  id              String       @id @default(cuid())
  type            ImportType
  status          ImportStatus @default(RUNNING)
  fileName        String
  totalRows       Int          @default(0)
  created         Int          @default(0)
  updated         Int          @default(0)
  unchanged       Int          @default(0)
  failed          Int          @default(0)
  errors          Json? // [{ row, agreementNo, reason }] for every failed row
  retailerSummary Json? // how a Loans import was split: { caller, retailer, perRetailer: [{ retailerId, code, name, customers, rejected }] }
  createdById     String
  startedAt       DateTime     @default(now())
  finishedAt      DateTime?

  @@index([type, startedAt])
}

enum Outcome {
  PAID
  PART_PAID
  PTP
  CALLBACK
  NOT_REACHABLE
  WRONG_NUMBER
  REFUSED_DISPUTE
  NOT_INTERESTED
}

// One recorded conversation outcome on a loan; never edited or deleted (a mistake is fixed by adding a new one).
model Disposition {
  id             String    @id @default(cuid())
  loanId         String
  loan           Loan      @relation(fields: [loanId], references: [id])
  agentId        String
  agent          User      @relation("AgentDispositions", fields: [agentId], references: [id])
  callId         String?   @unique // the call this outcome was recorded for (one call = one outcome); null for outcomes without a call
  call           Call?     @relation(fields: [callId], references: [id])
  outcome        Outcome
  ptpDate        DateTime? @db.Date
  ptpAmount      Decimal?  @db.Decimal(12, 2)
  paidAmount     Decimal?  @db.Decimal(12, 2) // agent-reported; the Phase 4 payments import becomes the source of truth
  nextFollowUpOn DateTime? @db.Date
  remarks        String?   @db.Text
  // Outcome-specific details. Which ones are filled depends on the outcome (see buildDispositionSchema); all are null for older rows.
  outcomeDetail   String?   @db.VarChar(20) // NO_ANSWER | BUSY (under NOT_REACHABLE), REFUSED | DISPUTE (under REFUSED_DISPUTE)
  paymentDate     DateTime? @db.Date // PAID / PART_PAID: the day the customer says the money was paid
  transactionRef  String?   @db.VarChar(100) // PAID: UPI / bank reference
  remainingAmount Decimal?  @db.Decimal(12, 2) // PART_PAID: overdue amount still unpaid when this was saved
  callbackTime    String?   @db.VarChar(5) // CALLBACK: "HH:mm" the customer asked to be called at (the date is nextFollowUpOn)
  reason          String?   @db.VarChar(500) // CALLBACK reason, refusal reason or dispute description
  category        String?   @db.VarChar(40) // DISPUTE category
  responses       InteractionResponse[]
  createdAt      DateTime  @default(now())

  @@index([loanId, createdAt])
  @@index([agentId, createdAt])
}

enum QuestionCategory {
  CUSTOMER_VERIFICATION
  PAYMENT_RELATED
  LOAN_RELATED
  PAYMENT_DELAY_REASON
  PROMISE_TO_PAY
  FOLLOW_UP_RELATED
  GENERAL_QUERIES
}

// A question an Admin wants agents to ask customers on collection calls. Agents only read active ones; they never create or change them.
model CustomerQuestion {
  id           String           @id @default(cuid())
  text         String           @db.VarChar(500)
  category     QuestionCategory
  displayOrder Int              @default(0) // lower first, within the category
  active       Boolean          @default(true)
  createdById  String
  createdBy    User             @relation("QuestionCreator", fields: [createdById], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([active, category, displayOrder])
  @@index([category])
}

// One customer answer saved with an interaction (Disposition). It keeps its own copy of the question text and category, and holds the
// question id as a plain string (no foreign key) so editing, deactivating or deleting a question never changes or removes saved history.
model InteractionResponse {
  id            String           @id @default(cuid())
  dispositionId String
  disposition   Disposition      @relation(fields: [dispositionId], references: [id])
  questionId    String? // the question this answered; may no longer exist
  questionText  String           @db.VarChar(500) // the question as the agent saw it
  category      QuestionCategory
  response      String           @db.Text
  remarks       String?          @db.VarChar(500)
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())

  @@index([dispositionId])
  @@index([questionId])
}

enum CallProvider {
  MOCK
  SARV
}

enum CallDirection {
  OUTBOUND
  INBOUND
}

enum CallStatus {
  INITIATED
  CONNECTED
  MISSED
  FAILED
}

// One phone call with a customer, placed or received through the telephony provider. Status only ever moves forward from INITIATED.
model Call {
  id                 String        @id @default(cuid())
  provider           CallProvider
  providerCallId     String?       @unique // set when the provider answers; the webhook upserts on it
  direction          CallDirection
  status             CallStatus    @default(INITIATED)
  loanId             String? // null only for an inbound call whose number matched no loan
  loan               Loan?         @relation(fields: [loanId], references: [id])
  agentId            String? // the agent who placed it (OUTBOUND) or whose queue it lands in (INBOUND)
  agent              User?         @relation("AgentCalls", fields: [agentId], references: [id])
  numberSlot         String? // "primary" | "alt": which customer number was dialled (never the number itself)
  customerNumberMask String? // masked, for display only
  startedAt          DateTime      @default(now())
  answeredAt         DateTime?
  endedAt            DateTime?
  durationSec        Int?
  recordingUrl       String?       @db.Text // provider URL, only ever served through /api/calls/[id]/recording
  failureReason      String?
  callbackResolvedAt DateTime? // INBOUND MISSED: when the agent called back
  rawEvents          Json? // last few provider payloads, for debugging the mapping
  disposition        Disposition?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([agentId, startedAt])
  @@index([loanId, startedAt])
  @@index([direction, status, callbackResolvedAt])
}

// One payment received on a loan, brought in by the Payments import. The source of truth for "collected" on the dashboards.
model Payment {
  id            String   @id @default(cuid())
  loanId        String
  loan          Loan     @relation(fields: [loanId], references: [id])
  amount        Decimal  @db.Decimal(12, 2)
  paidOn        DateTime @db.Date
  mode          String? // CASH / UPI / ... exactly as the file says (the hub format is not known yet)
  receiptNo     String?
  importRunId   String?
  source        String   @default("IMPORT") // "IMPORT" (payments file) or "MANUAL" (recorded in the app)
  collectedById String? // who recorded a MANUAL payment
  dedupeKey     String   @unique // loan + day + amount + receipt, so re-uploading a file never doubles a payment
  createdAt     DateTime @default(now())

  @@index([loanId, paidOn])
  @@index([paidOn])
}

// Admin-editable settings; a missing row means "use the default in lib/settings-defaults.ts".
model AppSetting {
  key         String   @id // e.g. "calling.window"
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

enum NotificationType {
  FOLLOW_UP_DUE
  PTP_DUE
  ESCALATION
  REASSIGNED
}

// An in-app message for one user about one loan; deduped so the morning job can run twice safely.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  entity    String // "loan"
  entityId  String
  dedupeKey String           @unique // type|entityId|userId|yyyy-MM-dd
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

// A one-time login code sent to an agent's mobile. Only a hash is stored; the code itself is never saved.
model OtpCode {
  id         String    @id @default(cuid())
  mobile     String
  userId     String? // null when the mobile matched no active agent (kept so request limits still count)
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([mobile, createdAt])
}

enum SettlementStatus {
  PENDING
  APPROVED
  REJECTED
}

// A one-time settlement offer on a loan: the customer pays `requestedAmount` and the rest of the overdue (`waiverAmount`) is waived.
// An agent asks; a Manager approves up to the Admin's limit (settlement.managerLimitPct), above that only an Admin can.
model Settlement {
  id              String           @id @default(cuid())
  loanId          String
  loan            Loan             @relation(fields: [loanId], references: [id])
  requestedById   String
  requestedAmount Decimal          @db.Decimal(12, 2)
  waiverAmount    Decimal          @db.Decimal(12, 2) // overdue at request time minus requestedAmount
  remarks         String?          @db.Text
  status          SettlementStatus @default(PENDING)
  decidedById     String?
  decidedAt       DateTime?
  decisionNote    String?          @db.Text
  createdAt       DateTime         @default(now())

  @@index([loanId, status])
  @@index([status, createdAt])
}

// A monthly goal for one caller or recruiter: money to recover and / or cases to resolve. Either can be left empty. Set by an Admin or Manager.
model AgentTarget {
  id               String   @id @default(cuid())
  userId           String
  month            String // "yyyy-MM"
  collectionAmount Decimal? @db.Decimal(12, 2)
  casesResolved    Int?
  updatedById      String?
  updatedAt        DateTime @updatedAt

  @@unique([userId, month])
  @@index([month])
}

enum RetailerStatus {
  ACTIVE
  INACTIVE
}

// A shop / partner that holds the customers whose uploaded rows carry its code (at most 20 per file). Never deleted, only set to INACTIVE (it then gets no new customers).
model Retailer {
  id          String         @id @default(cuid())
  code        String         @unique // the Retailer Code used in uploaded files, e.g. "RT-001"
  name        String
  ownerName   String
  mobile      String
  email       String?
  address     String?        @db.Text
  city        String?
  status      RetailerStatus @default(ACTIVE)
  customers   Customer[]
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
}
